{
    "name": "eagle-eye-solutions/doctrine-data-fixture-module",
    "description": "Zend Framework 3 Module that provides Doctrine Data-Fixture functionality",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "doctrine",
        "data-fixture",
        "module",
        "laminas"
    ],
    "authors": [
        {
            "name": "Daniel Korsak",
            "email": "danielkorsak@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2.35",
        "doctrine/data-fixtures": "^2.2.0",
        "doctrine/doctrine-orm-module": "^4.0 || ^6.0",
        "laminas/laminas-modulemanager": "~2.0",
        "laminas/laminas-eventmanager": "~3.0",
        "laminas/laminas-servicemanager": "~3.0"
    },
    "autoload": {
        "psr-0": {
            "DoctrineDataFixtureModule\\": "src/"
        }
    },
    "require-dev": {
        "rector/rector": "^2.5"
    }
}
